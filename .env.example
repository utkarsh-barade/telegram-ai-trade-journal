# ─────────────────────────────────────────────
# Telegram Bot Secrets
# ─────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of authorized Telegram user IDs
ALLOWED_USER_IDS=123456789,987654321

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# SQLite (default for local dev)
DATABASE_URL=sqlite:///./trade_journal.db

# PostgreSQL example (for production migration):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trade_journal

# ─────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────
LOG_LEVEL=INFO

# Time-window (minutes) to flag a duplicate trade
DUPLICATE_WINDOW_MINUTES=5

# Optional: webhook URL (leave empty to use polling)
WEBHOOK_URL=
